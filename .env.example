# Copy this file to ".env" in the project root (D:\Projects\RetailIQ\.env) and fill in your own key.
# .env is listed in .gitignore and must never be committed.

# Leave empty to run the assistant in demo mode (rule-based, no language model).
ANTHROPIC_API_KEY=

# Optional
RETAILIQ_MODEL=claude-haiku-5-5
RETAILIQ_AGENT_RPM=20
